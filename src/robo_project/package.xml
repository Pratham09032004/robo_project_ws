<?xml version="1.0"?>
<package format="3">
  <name>robo_project</name>
  <version>0.0.0</version>
  <description>CMN navigation project</description>
  <maintainer email="robot_@todo.todo">robot_</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>launch_ros</depend>
  <depend>launch</depend>
  <depend>ament_index_python</depend>
  <depend>sensor_msgs_py</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-networkx</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <!-- Not available through rosdep: torch, torchvision (pip) and habitat_sim (conda). -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
