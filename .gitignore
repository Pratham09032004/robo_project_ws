# ===== colcon build output =====
build/
install/
log/

# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
.eggs/
*.env
.venv/
env/

# ===== Large ML checkpoints (share big ones via Drive) =====
# The small weights the nodes load (ml_pipeline/*.pth, ml_runs/*.pth) are
# already tracked; add new ones explicitly with `git add -f`.
*.pt
*.pth

# ===== Data / arrays =====
# Keep occupancy maps used by the config tracked.
*.npy
!src/robo_project/config/maps/*.npy

# ===== Logs, temp, backups =====
*.log
*.stamp
*.swp
*.out
*.last
*.marks
*.built_by
*.pack
backup_before_*

# ===== Shell / env configs (often user-specific) =====
*.rc

# ===== Archives (share via Drive instead) =====
*.zip

# ===== Editor/OS junk =====
.vscode/
.idea/
*.DS_Store

# ===== conda env exports (keep environment.yml if you use one, ignore the folder itself) =====
conda_env/
envs/
